# Copy to .env (never commit the real one)
ENV=development
DATABASE_URL=postgresql+asyncpg://localhost/universalpos
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Comma-separated origins in production; '*' is refused when ENV=production
CORS_ORIGINS=*
# First platform super-admin password (development default: admin12345)
# SEED_ADMIN_PASSWORD=
